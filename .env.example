ENVIRONMENT=dev
# log format follows ENVIRONMENT above: "dev" = colored dev logs; anything else (including unset) = structured JSON for prod log platforms

POSTGRES_DB=rivervoice
POSTGRES_USER=postgres
POSTGRES_PORT=5432

POSTGRES_PASSWORD=postgres
APP_USER_PASSWORD=app_user
APP_WORKER_PASSWORD=app_worker

# The supabase/postgres image always provisions its main database as
# `postgres` (docker-compose.yml hardcodes POSTGRES_DB: postgres regardless
# of POSTGRES_DB above) — ferry connects as the postgres superuser itself,
# same as migrations, since it needs to bypass RLS for its own writes.
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@localhost:5432/postgres
MIGRATE_DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@localhost:5432/postgres
# The one shared secret for the whole Supabase stack, not just ferry's own
# tokens — GoTrue signs with this, PostgREST/ferry verify with it. Must be
# at least 32 bytes. This dev value is fine to use as-is locally.
JWT_SECRET=dev-only-secret-replace-me-with-32-plus-random-bytes
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
PORT=8080

# supabase — kong is the one public entrypoint (localhost:8000); auth/rest/
# storage below have no published ports of their own.
API_EXTERNAL_URL=http://localhost:8000
SITE_URL=http://localhost:3000
# Static service keys, not session tokens — HS256 JWTs signed with JWT_SECRET
# above, role=anon / role=service_role, no real expiry. These are self-signed
# for this project's own local stack (not Supabase Cloud credentials), so
# they're safe to keep as-is for local dev — regenerate (and update
# supabase/kong.yml to match) only if you change JWT_SECRET.
ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWxvY2FsIiwiaWF0IjoxNzg4MTE0ODkyLCJleHAiOjIxMDM0NzQ4OTJ9.jZInlEx5NPIwvEUiSi-4CAOXGPY84abt9_UbajruYPA
SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoic2VydmljZV9yb2xlIiwiaXNzIjoic3VwYWJhc2UtbG9jYWwiLCJpYXQiOjE3ODgxMTQ4OTIsImV4cCI6MjEwMzQ3NDg5Mn0.dnjGnpMBMCTDjw3_4zWjxi0zrSzgmMD823dYwY3hBYI

# ferry — real values are secrets, fill these in yourself, never commit them
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TWIML_APP_SID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_FROM_NUMBER=+1xxxxxxxxxx
TWILIO_TO_NUMBER=+91xxxxxxxxxx

# Set this to whatever `cloudflared tunnel --url http://localhost:8085` prints
# (ferry's own port — Twilio's stream/status-callback URLs are built from this).
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com

SARVAM_TTS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

SARVAM_STT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

DEEPGRAM_STT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ferry's real LAN IP — WebRTC audio breaks silently if this binds to
# 0.0.0.0 instead (see ferry/src/transport/webrtc/transport.rs). Must match
# whatever address mobile clients actually reach ferry on.
WEBRTC_BIND_IP=xxx.xxx.xxx.xxx

OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
