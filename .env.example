# Rivervoice — environment template (committed). Copy to .env.development /
# .env.production and fill. The switch lives in the root .env (gitignored):
# ENVIRONMENT=development loads .env.development, ENVIRONMENT=production
# loads .env.production. Copy this file to .env, set the variable, and the
# config picks the right file. Root .env loads first, so any other variable
# defined there (not just ENVIRONMENT) takes precedence over the same key in
# the profile file. See ferry/src/config.rs:environment()/load_dotenv().

ENVIRONMENT=development # controlling var — 'development' loads .env.development, 'production' loads .env.production
# ENVIRONMENT=production — use in .env.production; dev logs are colored, prod logs are JSON

POSTGRES_DB=rivervoice # Postgres database name (docker-compose hardcodes `postgres` for supabase/postgres image, but ferry uses this name for own checks)
POSTGRES_PASSWORD=postgres # Postgres password — used in DATABASE_URL and docker-compose db service
DATABASE_URL=postgres://postgres:${POSTGRES_PASSWORD}@localhost:5432/postgres # Postgres connection URI — ferry & migrations connect here (use Cloud pooled URI in .env.prd)
JWT_SECRET=dev-only-secret-replace-me-with-32-plus-random-bytes # Shared HS256 secret — GoTrue signs with this, PostgREST/ferry verify with it, must be >=32 bytes
PORT=8080 # Ferry HTTP port

# supabase — kong is the one public entrypoint (localhost:8000 locally, Cloud URL in prod)
SUPABASE_URL=http://localhost:8000 # Supabase project URL — Kong gateway locally, https://<ref>.supabase.co in prod
SUPABASE_JWKS_URL=http://localhost:8000/auth/v1/.well-known/jwks.json # JWKS URL for JWT verification (Cloud: https://<ref>.supabase.co/auth/v1/.well-known/jwks.json)
SUPABASE_PUBLISHABLE_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # Publishable API key (sb_publishable_... in Cloud) — safe for client, RLS restricts it. For local: a JWT with role "anon", signed with JWT_SECRET below — see docs/self-hosting or generate via jwt.io
SUPABASE_SECRET_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # Secret API key (sb_secret_... in Cloud) — server-only, bypasses RLS, never expose to client. For local: a JWT with role "service_role", signed with the same JWT_SECRET
SUPABASE_RECORDINGS_BUCKET=recordings # Supabase Storage bucket for call recordings

# ferry — external services (real secrets, never commit)
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com # Google OAuth web client ID for Supabase Auth
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # Twilio account SID
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # Twilio auth token
TWILIO_TWIML_APP_SID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # Twilio TwiML App SID for voice
TWILIO_FROM_NUMBER=+1xxxxxxxxxx # Twilio phone number (caller ID)
TWILIO_TO_NUMBER=+91xxxxxxxxxx # Default destination number (for testing)
PUBLIC_BASE_URL=https://your-tunnel.trycloudflare.com # Public base URL for Twilio webhooks — cloudflared tunnel or prod domain
SARVAM_TTS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # Sarvam TTS API key
SARVAM_STT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # Sarvam STT API key
DEEPGRAM_STT_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # Deepgram STT API key
WEBRTC_BIND_IP=xxx.xxx.xxx.xxx # Ferry WebRTC bind IP — must be real LAN IP for physical devices, 0.0.0.0 for emulator
WEBRTC_PUBLIC_IP= # Only set behind 1:1 NAT (e.g. AWS/Lightsail) where WEBRTC_BIND_IP's address isn't what callers can reach — the static public IP gets swapped in for it in the SDP answer. Leave empty for same-LAN dev.
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx # OpenRouter API key for MT
