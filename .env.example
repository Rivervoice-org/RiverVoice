ENVIRONMENT=dev

POSTGRES_DB=rivervoice
POSTGRES_USER=postgres
POSTGRES_PORT=5432

POSTGRES_PASSWORD=postgres
APP_USER_PASSWORD=app_user
APP_WORKER_PASSWORD=app_worker

# harbor
DATABASE_URL=postgres://app_worker:app_worker@localhost:5432/rivervoice
MIGRATE_DATABASE_URL=postgres://postgres:postgres@localhost:5432/rivervoice
JWT_SECRET=dev-only-secret-replace-me-with-32-plus-random-bytes
COOKIE_SECURE=false
WEB_ORIGIN=http://localhost:3000
PORT=8080

# ferry
# log format follows ENVIRONMENT above: "dev" = colored dev logs; anything else (including unset) = structured JSON for prod log platforms
