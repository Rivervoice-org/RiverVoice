# docker-compose.yml. Copy to .env and fill in.

POSTGRES_DB=rivervoice
POSTGRES_USER=postgres
POSTGRES_PORT=5432

# Owns the schema; migrations run as this.
POSTGRES_PASSWORD=

# harbor's per-request role. RLS applies.
APP_USER_PASSWORD=

# ferry and cross-tenant jobs. Bypasses RLS.
APP_WORKER_PASSWORD=
