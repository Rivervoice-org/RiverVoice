# Public cloudflared quick-tunnel fronting ferry on :8085, so the device does
# not have to be on the same WiFi. Quick-tunnel hostnames are ephemeral —
# they die with the cloudflared process, so re-run the tunnel and update this
# whenever calls start failing to connect. The same URL belongs in
# PUBLIC_BASE_URL in the repo-root .env. For same-WiFi testing the LAN form
# (http://<ipconfig IPv4>:8085) also works and is lower latency.
EXPO_PUBLIC_FERRY_URL=https://your-tunnel.trycloudflare.com
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# Kong's gateway (docker-compose.yml), not any individual Supabase service
# directly. LAN form for now, same as the comment above suggests for ferry —
# swap for a cloudflared tunnel the same way if testing off-WiFi.
EXPO_PUBLIC_SUPABASE_URL=http://<your-lan-ip>:8000
# The anon key from the repo-root .env's ANON_KEY — safe to ship client-side,
# RLS is what actually restricts it, not secrecy of this value. The default
# local-dev value below matches the one in the root .env.example.
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWxvY2FsIiwiaWF0IjoxNzg4MTE0ODkyLCJleHAiOjIxMDM0NzQ4OTJ9.jZInlEx5NPIwvEUiSi-4CAOXGPY84abt9_UbajruYPA
