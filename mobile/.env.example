# "production" or "development" — picks which *_PROD or *_DEV vars below
# config.ts reads. Mirrors ferry's ENVIRONMENT switch (ferry/src/config.rs).
EXPO_PUBLIC_ENVIRONMENT=development

# Same OAuth client for both environments, so it isn't split like the vars
# below.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# ==================== PRODUCTION ====================

EXPO_PUBLIC_FERRY_URL_PROD=https://your-tunnel.trycloudflare.com
EXPO_PUBLIC_SUPABASE_URL_PROD=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY_PROD=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx

# ==================== DEVELOPMENT ====================

# Public cloudflared quick-tunnel fronting ferry on :8085, so the device does
# not have to be on the same WiFi. Quick-tunnel hostnames are ephemeral —
# they die with the cloudflared process, so re-run the tunnel and update this
# whenever calls start failing to connect. The same URL belongs in
# PUBLIC_BASE_URL in the repo-root .env. For same-WiFi testing the LAN form
# (http://<ipconfig IPv4>:8085) also works and is lower latency.
EXPO_PUBLIC_FERRY_URL_DEV=https://your-tunnel.trycloudflare.com

# Kong's gateway (docker-compose.yml), not any individual Supabase service
# directly. LAN form for now, same as the comment above suggests for ferry —
# swap for a cloudflared tunnel the same way if testing off-WiFi.
EXPO_PUBLIC_SUPABASE_URL_DEV=http://<your-lan-ip>:8000
# Publishable key (sb_publishable_...) — new Supabase API key, safe to ship
# client-side, RLS is what restricts it. For local, use SUPABASE_PUBLISHABLE_KEY
# from root .env. For Cloud, use the publishable key from Dashboard > API Keys.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY_DEV=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlLWxvY2FsIiwiaWF0IjoxNzg4MTE0ODkyLCJleHAiOjIxMDM0NzQ4OTJ9.jZInlEx5NPIwvEUiSi-4CAOXGPY84abt9_UbajruYPA
